# Copia este archivo a backend/.env y completa los valores desde Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Necesaria para guardar predicciones y trasladar historial verificado.
# Nunca usar en clientes públicos ni compartir por chat.
SUPABASE_SECRET_KEY=

# Los pesos del resultado unificado ya no se configuran aquí: salen de la calibración
# conjunta (datasets/combinacion_produccion/combinacion.json). ANALYSIS_MBERT_WEIGHT se ignora.

# Cadena de desarrollo local. Usa una clave de una cuenta de Anvil; nunca la publiques.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=

# Servidor del LLM para la verificación web (incremento 2): llama-server con API tipo OpenAI.
# Sin LLM_BASE_URL la verificación no corre. LLM_API_KEY es la que se pasa a llama-server
# con --api-key-file; ponla solo en tu archivo local, nunca aquí.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=
LLM_API_KEY=

# Cola de verificación web (incremento 2). Apagada salvo VERIFICATION_ENABLED=true; encender solo
# con la migración 008 aplicada. VERIFICATION_DESDE: el barrido solo encola análisis posteriores
# a esa fecha (ISO 8601 con zona horaria). VERIFICATION_MAX_ATTEMPTS: intentos antes de «fallida».
VERIFICATION_ENABLED=
VERIFICATION_DESDE=
VERIFICATION_MAX_ATTEMPTS=

# Búsqueda web de la verificación (incremento 2, D3). SEARCH_PROVIDER: brave o tavily. Sin
# SEARCH_PROVIDER y SEARCH_API_KEY no hay búsqueda. A los buscadores solo salen las afirmaciones
# reescritas, nunca la URL ni la identidad del usuario. SEARCH_TIMEOUT en segundos (15 por omisión).
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_TIMEOUT=
# Límites por afirmación (cada uno tiene un valor por omisión en backend/core/config.py): consultas
# (1-2), páginas descargadas, tamaño máximo de página en bytes, segundos por página y por afirmación.
VERIFICATION_MAX_QUERIES=
VERIFICATION_MAX_PAGES=
VERIFICATION_PAGE_BYTES=
VERIFICATION_PAGE_SECONDS=
VERIFICATION_CLAIM_SECONDS=
# Tiempo máximo de un caso completo (segundos, 300 por omisión); al agotarse, las afirmaciones que
# faltan quedan «insuficiente» y el caso termina con lo que haya.
VERIFICATION_CASE_SECONDS=

# Orígenes de la web pública y del panel (web/), separados por comas.
WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
