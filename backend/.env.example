# Copia este archivo a backend/.env y completa los valores desde Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Necesaria para guardar predicciones y trasladar historial verificado.
# Nunca usar en clientes públicos ni compartir por chat.
SUPABASE_SECRET_KEY=

# Peso de mBERT para el resultado unificado cuando ambos modelos respondan.
# El peso de BiLSTM será 1 menos este valor; con un solo modelo su peso es 1.
ANALYSIS_MBERT_WEIGHT=0.70

# Cadena de desarrollo local. Usa una clave de una cuenta de Anvil; nunca la publiques.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_PRIVATE_KEY=
